{
  "name": "unin-desktop-being",
  "version": "2.0.0",
  "description": "UNIN - Universal Neural Intelligence Network Autonomous Desktop Being",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron electron-main.js",
    "desktop": "electron electron-main.js",
    "build:avatar": "esbuild src/avatar.js --bundle --outfile=dist/avatar.bundle.js --format=iife --platform=browser --target=chrome112 --minify",
    "server": "node server.js",
    "test": "node scratch/test-tool-registry.js",
    "test:tools": "node scratch/test-tool-registry.js",
    "test:goal": "node scratch/test-goal-engine.js",
    "test:swarm": "node scratch/test-swarm-orchestrator.js",
    "test:watchdog": "node scratch/test-visual-watchdog.js",
    "test:voice": "node scratch/test-voice-normalizer.js",
    "test:scheduler": "node scratch/test-scheduler.js",
    "test:master": "node scratch/test-unin-3-master.js",
    "test:neural-audio": "node scratch/test-neural-audio.js",
    "test:all": "node scratch/test-tool-registry.js && node scratch/test-scheduler.js && node scratch/test-goal-engine.js && node scratch/test-swarm-orchestrator.js && node scratch/test-visual-watchdog.js && node scratch/test-wake-word.js && node scratch/test-unin-3-master.js && node scratch/test-neural-audio.js",
    "package:dir": "electron-builder --dir",
    "package:win": "electron-builder --win",
    "package:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.unin.desktop",
    "productName": "UNIN",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UNIN"
    },
    "files": [
      "**/*",
      "!release/**/*",
      "!scratch/**/*",
      "!**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subbareddypalagiri/face-of-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/subbareddypalagiri/face-of-ai/issues"
  },
  "homepage": "https://github.com/subbareddypalagiri/face-of-ai#readme",
  "dependencies": {
    "@composio/core": "^0.22.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pixiv/three-vrm": "^3.5.5",
    "msedge-tts": "^2.0.9",
    "playwright": "^1.63.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.5.1"
  }
}
